__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.db
*.sqlite3

# Virtual envs
venv/
env/
ENV/
.venv/
env.bak/

# Flask specific
instance/
uploads/
reports/
screenshots/
api_server.log
*.log

# ============================================
# Node / React (frontend folder)
# ============================================
# node modules for the frontend only
frontend/node_modules/

# React build output and local env
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# package manager logs / lockfiles (optional to ignore lockfile)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================
# Project config / generated files
# ============================================
dist/
.cache/
coverage/

